# Copy to server/.env and fill in ONE provider key.
# With no key set, the app runs in "mock" mode (canned replies) so the UI and
# safety layer can still be demoed.

# openai | anthropic | mock. Leave empty to auto-detect from the keys below.
LLM_PROVIDER=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Optional, only for reasoning models (minimal | low | medium | high).
OPENAI_REASONING_EFFORT=low

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Optional, on models that support it (low | medium | high | xhigh | max).
ANTHROPIC_EFFORT=

# Which helplines to show in crisis replies: PK | AE | INTL
HELPLINE_REGION=PK

PORT=3001
LLM_TIMEOUT_MS=45000
